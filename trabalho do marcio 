        "import random\n",
        "\n",
        "# Configurações de tipos de loteria\n",
        "loterias = {\n",
        "    \"Mega Sena\": {\"intervalo\": (1, 60), \"quantidade\": 6},\n",
        "    \"Quina\": {\"intervalo\": (1, 80), \"quantidade\": 5},\n",
        "    \"Lotofácil\": {\"intervalo\": (1, 25), \"quantidade\": 15}\n",
        "}\n",
        "\n",
        "def escolher_loteria():\n",
        "    print(\"Escolha o tipo de loteria:\")\n",
        "    for i, tipo in enumerate(loterias.keys()):\n",
        "        print(f\"{i + 1} - {tipo}\")\n",
        "    escolha = int(input(\"Digite o número correspondente: \")) - 1\n",
        "    loteria = list(loterias.keys())[escolha]\n",
        "    return loteria, loterias[loteria]\n",
        "\n",
        "def gerar_numeros(loteria_config):\n",
        "    intervalo = loteria_config[\"intervalo\"]\n",
        "    quantidade = loteria_config[\"quantidade\"]\n",
        "    return random.sample(range(intervalo[0], intervalo[1] + 1), quantidade)\n",
        "\n",
        "def obter_numeros_usuario(loteria_config):\n",
        "    quantidade = loteria_config[\"quantidade\"]\n",
        "    intervalo = loteria_config[\"intervalo\"]\n",
        "    numeros = set()\n",
        "    while len(numeros) < quantidade:\n",
        "        try:\n",
        "            num = int(input(f\"Digite um número entre {intervalo[0]} e {intervalo[1]}: \"))\n",
        "            if num < intervalo[0] or num > intervalo[1]:\n",
        "                print(\"Número fora do intervalo. Tente novamente.\")\n",
        "            elif num in numeros:\n",
        "                print(\"Número repetido. Tente novamente.\")\n",
        "            else:\n",
        "                numeros.add(num)\n",
        "        except ValueError:\n",
        "            print(\"Entrada inválida. Digite um número inteiro.\")\n",
        "    return list(numeros)\n",
        "\n",
        "def comparar_numeros(sorteados, usuario):\n",
        "    acertos = set(sorteados) & set(usuario)\n",
        "    return len(acertos), acertos\n",
        "\n",
        "def simular_loteria():\n",
        "    # Definir semente aleatória para gerar novos resultados a cada execução\n",
        "    random.seed()\n",
        "\n",
        "    # Escolher o tipo de loteria\n",
        "    tipo_loteria, config = escolher_loteria()\n",
        "\n",
        "    # Gerar números aleatórios\n",
        "    numeros_sorteados = gerar_numeros(config)\n",
        "\n",
        "    # Obter números do usuário\n",
        "    print(f\"\\nDigite seus números para {tipo_loteria}:\")\n",
        "    numeros_usuario = obter_numeros_usuario(config)\n",
        "\n",
        "    # Comparar os números sorteados com os números do usuário\n",
        "    acertos_count, acertos = comparar_numeros(numeros_sorteados, numeros_usuario)\n",
        "\n",
        "    # Exibir resultados\n",
        "    print(\"\\n--- Resultados ---\")\n",
        "    print(f\"Números sorteados ({tipo_loteria}): {sorted(numeros_sorteados)}\")\n",
        "    print(f\"Seus números: {sorted(numeros_usuario)}\")\n",
        "    print(f\"Quantidade de acertos: {acertos_count}\")\n",
        "    if acertos_count > 0:\n",
        "        print(f\"Você acertou os números: {sorted(acertos)}\")\n",
        "    if acertos_count == config[\"quantidade\"]:\n",
        "        print(\"Parabéns! Você acertou todos os números!\")\n",
        "    else:\n",
        "        print(\"Boa sorte na próxima vez!\")\n",
        "\n",
        "# Executar a simulação\n",
        "simular_loteria()"
