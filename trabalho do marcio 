        "def calcular_lados_com_angulo(lado, angulo, lado_conhecido):\n",
        "    \"\"\"Calcula os dois lados restantes quando um lado e um ângulo são conhecidos\"\"\"\n",
        "    angulo_rad = math.radians(angulo)\n",
        "    if lado_conhecido == 'oposto':\n",
        "        adjacente = lado / math.tan(angulo_rad)\n",
        "        hipotenusa = lado / math.sin(angulo_rad)\n",
        "    elif lado_conhecido == 'adjacente':\n",
        "        oposto = lado * math.tan(angulo_rad)\n",
        "        hipotenusa = lado / math.cos(angulo_rad)\n",
        "    else:  # lado conhecido é a hipotenusa\n",
        "        oposto = lado * math.sin(angulo_rad)\n",
        "        adjacente = lado * math.cos(angulo_rad)\n",
        "    return hipotenusa, oposto, adjacente\n",
