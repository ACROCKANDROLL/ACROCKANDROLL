        "import re\n",
        "from collections import Counter\n",
        "\n",
        "def ler_texto():\n",
        "    escolha = input(\"Digite 1 para inserir o texto manualmente ou 2 para ler de um arquivo: \")\n",
        "    if escolha == '1':\n",
        "        texto = input(\"Digite o texto para análise: \")\n",
        "    elif escolha == '2':\n",
        "        nome_arquivo = input(\"Digite o nome do arquivo: \")\n",
        "        try:\n",
        "            with open(nome_arquivo, 'r') as arquivo:\n",
        "                texto = arquivo.read()\n",
        "        except FileNotFoundError:\n",
        "            print(\"Arquivo não encontrado.\")\n",
        "            return None\n",
        "    else:\n",
        "        print(\"Opção inválida.\")\n",
        "        return None\n",
        "    return texto\n",
        "\n",
        "def contar_palavras(texto):\n",
        "    palavras = re.findall(r'\\b\\w+\\b', texto.lower())\n",
        "    return len(palavras), Counter(palavras)\n",
        "\n",
        "def contar_frases(texto):\n",
        "    frases = re.split(r'[.!?]', texto)\n",
        "    frases = [frase.strip() for frase in frases if frase.strip()]\n",
        "    return len(frases)\n",
        "\n",
        "def caracteres(texto):\n",
        "    letras = sum(1 for char in texto if char.isalpha())\n",
        "    numeros = sum(1 for char in texto if char.isdigit())\n",
        "    espacos = sum(1 for char in texto if char.isspace())\n",
        "    pontuacao = sum(1 for char in texto if not char.isalnum() and not char.isspace())\n",
        "    return {'Letras': letras, 'Números': numeros, 'Espaços': espacos, 'Pontuação': pontuacao}\n",
        "\n",
        "def analisar_texto():\n",
        "    texto = ler_texto()\n",
        "    if not texto:\n",
        "        return\n",
        "\n",
        "    # Contagem de palavras e frequência de cada palavra\n",
        "    num_palavras, freq_palavras = contar_palavras(texto)\n",
        "    palavra_mais_frequente, frequencia_max = freq_palavras.most_common(1)[0]\n",
        "\n",
        "    # Contagem de frases\n",
        "    num_frases = contar_frases(texto)\n",
        "\n",
        "    # Contagem de caracteres\n",
        "    contagem_caracteres = caracteres(texto)\n",
        "\n",
        "    # Exibir resultados\n",
        "    print(\"\\nEstatísticas do texto:\")\n",
        "    print(f\"Número de palavras: {num_palavras}\")\n",
        "    print(f\"Número de frases: {num_frases}\")\n",
        "    print(\"Frequência de palavras:\", freq_palavras)\n",
        "    print(f\"Palavra mais frequente: '{palavra_mais_frequente}' (aparece {frequencia_max} vezes)\")\n",
        "    print(\"Contagem de tipos de caracteres:\", contagem_caracteres)\n",
        "\n",
        "# Executa a análise\n",
        "analisar_texto()\n"
